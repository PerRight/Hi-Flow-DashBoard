[Unit]
Description=UWD 클라우드 미러 서버 (FastAPI)
Documentation=https://github.com/PerRight/Hi-Flow-DashBoard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hiflow
Group=hiflow
WorkingDirectory=/home/hiflow/app/server

# ⚠️ CLAUDE.md 6절 — 목업은 절대 켜지 않는다.
#    실기 feed 가 끊겼을 때 목업이 조용히 이어받아 가짜 값을 status:"ok" 로
#    표시하는 것이 이 프로젝트가 정의한 "최악의 버그"다.
#    경로 검증 시에만 아래 줄의 주석을 풀고, 검증이 끝나면 반드시 다시 주석 처리한다.
# Environment=UWD_MOCK=1
Environment=UWD_MOCK=0
Environment=UWD_DB=/home/hiflow/app/server/data/records.db

# ── 미러 모드 (사용자 확정 2026-09-13) ─────────────────────────────────
# 이 서버는 **미러**다: 자기 윈치 상태기계를 돌리지 않고, 라즈베리파이 forwarder 가
# /ws/mirror 로 보낸 값을 그대로 저장·중계한다 (CLAUDE.md 0절).
# 이걸 켜지 않으면 클라우드가 제 수심 상태기계를 돌려 보트와 다른 값을 표시한다.
Environment=UWD_MIRROR=1

# 토큰은 파일로만 준다 — 유닛에 직접 쓰면 `systemctl cat` 으로 그대로 읽힌다.
#   sudo install -m 600 -o hiflow -g hiflow /dev/null /etc/uwd-mirror.env
#   sudo nano /etc/uwd-mirror.env      →  UWD_MIRROR_TOKEN=<라즈베리파이와 같은 값>
# 토큰이 비어 있으면 서버가 기동을 거부한다(인증 없는 수신구를 열지 않는다).
EnvironmentFile=/etc/uwd-mirror.env

ExecStart=/home/hiflow/app/server/.venv/bin/python -m uvicorn app:app \
          --host 127.0.0.1 --port 8000

# 127.0.0.1 로 묶는 이유: 외부 노출은 nginx 가 443 으로만 담당한다.
# 8000 을 직접 열어두면 HTTPS 를 우회한 평문 접속이 남는다.

Restart=always
RestartSec=3

# 종료 시 store.flush() 가 미커밋분을 기록할 시간을 준다 (5초 배치 커밋)
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
